# Supabase Postgres — connection strings from Project Settings > Database
# Pooled (pgbouncer, port 6543) — used by the app's runtime Prisma Client.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (port 5432) — used only by Prisma migrations/introspection (see prisma.config.ts).
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Supabase API — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxx"
# Server-only — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY="xxxxx"
